# Self-hosted production (docker-compose.prod.yml). Copy to `.env.prod` (gitignored) and fill in.

# ---- Caddy (HTTPS) ----
# Public domain pointing at this server (ports 80 and 443 open) → Let's Encrypt certificate:
SITE_ADDRESS=quiz.example.fr
TLS_MODE=vous@example.fr
# LAN only, no domain: the server's IP and Caddy's own certificate (browsers warn at first):
# SITE_ADDRESS=192.168.1.50
# TLS_MODE=internal

# ---- App ----
# The address players and hosts type (https, no trailing slash).
CORS_ORIGIN=https://quiz.example.fr
PUBLIC_URL=https://quiz.example.fr
PUBLIC_WEB_URL=https://quiz.example.fr

# Postgres (Neon: the pooled URL for the app, the direct one for migrations).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Firebase Auth (optional; without it, local accounts). Add SITE_ADDRESS to the authorized
# domains in the Firebase console (Authentication → Paramètres → Domaines autorisés).
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# E-mails (password reset, local accounts only), optional — see DEPLOY.md §4b.
# SMTP_URL=smtps://user:pass@smtp-relay.brevo.com:465
# MAIL_FROM=Le Bon Quizz <noreply@example.fr>

# Sentry (optional).
# SENTRY_DSN=
