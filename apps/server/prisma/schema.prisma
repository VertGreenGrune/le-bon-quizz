// Data model — see docs/PLAN.md §5. Connection URL lives in prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  createdAt    DateTime      @default(now())
  quizzes      Quiz[]
  sessions     Session[]
  gameSessions GameSession[]
}

/// Host login session. `id` is the SHA-256 of the opaque token given to the client.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Quiz {
  id            String        @id @default(cuid())
  ownerId       String
  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  coverImageUrl String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  questions     Question[]
  gameSessions  GameSession[]

  @@index([ownerId])
}

enum QuestionType {
  MCQ
  TRUE_FALSE
}

model Question {
  id           String       @id @default(cuid())
  quizId       String
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order        Int
  text         String
  imageUrl     String?
  type         QuestionType @default(MCQ)
  timeLimitSec Int          @default(20)
  basePoints   Int          @default(1000)
  choices      Choice[]

  @@unique([quizId, order])
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int // 0–3, maps to the shape/color (see SHAPES in @lbq/shared)
  text       String
  isCorrect  Boolean

  @@unique([questionId, order])
}

model GameSession {
  id        String         @id @default(cuid())
  /// Null once the quiz is deleted; history is kept thanks to `quizTitle`.
  quizId    String?
  quiz      Quiz?          @relation(fields: [quizId], references: [id], onDelete: SetNull)
  quizTitle String
  hostId    String
  host      User           @relation(fields: [hostId], references: [id], onDelete: Cascade)
  pin       String
  mode      GameMode         @default(solo)
  startedAt DateTime         @default(now())
  endedAt   DateTime?
  results   PlayerResult[]
  questions QuestionResult[]
  teams     TeamResult[]

  @@index([hostId, startedAt])
}

model PlayerResult {
  id            String      @id @default(cuid())
  gameSessionId String
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  nickname      String
  score         Int
  correctCount  Int
  rank          Int
  /// Team mode: team id (0–3 = shape index, see TEAM_NAMES in @lbq/shared); null in solo games.
  teamId        Int?

  @@index([gameSessionId, rank])
}

enum GameMode {
  solo
  teams
}

/// Team mode: final standing of one team (score = sum of per-question averages, PLAN.md §3).
model TeamResult {
  id            String      @id @default(cuid())
  gameSessionId String
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  teamId        Int
  name          String
  score         Int
  /// Players in the team at the end of the game.
  playerCount   Int
  rank          Int

  @@unique([gameSessionId, teamId])
}

/// Snapshot of one played question (text/choices as they were) and how players answered it.
model QuestionResult {
  id             String      @id @default(cuid())
  gameSessionId  String
  gameSession    GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  /// Position in the quiz (0-based).
  index          Int
  text           String
  choices        String[]
  correctIndexes Int[]
  /// Number of players per choice (same order as `choices`).
  distribution   Int[]
  /// Players in the game when the question was revealed (answered or not).
  playerCount    Int
  correctCount   Int

  @@unique([gameSessionId, index])
}
