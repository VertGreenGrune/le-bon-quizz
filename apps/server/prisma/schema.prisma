// Data model — see docs/PLAN.md §5. Connection URL lives in prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  /// Null for accounts created through Firebase (T46): they have no password here.
  passwordHash        String?
  /// T46: Firebase Auth user id (`sub` of its ID tokens), set at the first Firebase sign-in.
  firebaseUid         String?              @unique
  createdAt           DateTime             @default(now())
  quizzes             Quiz[]
  sessions            Session[]
  gameSessions        GameSession[]
  passwordResetTokens PasswordResetToken[]
  quizShares          QuizShare[]
}

/// Host login session. `id` is the SHA-256 of the opaque token given to the client.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// "Mot de passe oublié" link. `id` is the SHA-256 of the token sent by e-mail; valid 1 hour,
/// single use (`usedAt`). A new request deletes the user's previous unused tokens.
model PasswordResetToken {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Quiz {
  id            String         @id @default(cuid())
  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  coverImageUrl String?
  /// PUBLIC quizzes are listed in the library and can be launched / copied by any host.
  visibility    QuizVisibility @default(PRIVATE)
  /// TV theme (T40): colors, background, music and confetti of the game.
  theme         QuizTheme      @default(classic)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  questions     Question[]
  gameSessions  GameSession[]
  shares        QuizShare[]

  @@index([ownerId])
  @@index([visibility, createdAt])
}

enum QuizVisibility {
  PRIVATE
  PUBLIC
}

/// T45: a quiz shared by its owner with another host account.
model QuizShare {
  quizId    String
  quiz      Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// viewer = see, launch, copy; editor = also edit the quiz.
  role      ShareRole @default(viewer)
  createdAt DateTime  @default(now())

  @@id([quizId, userId])
  @@index([userId])
}

enum ShareRole {
  viewer
  editor
}

enum QuizTheme {
  classic
  halloween
  christmas
  retro
  space
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  TYPE_ANSWER
  POLL
  SLIDER
  ORDER
  PIN
  WHO_OF_US
  WORD_CLOUD
  BLUFF
  DRAW
  LIST
}

model Question {
  id               String       @id @default(cuid())
  quizId           String
  quiz             Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order            Int
  text             String
  imageUrl         String?
  type             QuestionType @default(MCQ)
  timeLimitSec     Int          @default(20)
  basePoints       Int          @default(1000)
  /// MCQ / TRUE_FALSE / POLL (poll choices are all `isCorrect: false`); empty for the others.
  choices          Choice[]
  /// Type-specific settings: TYPE_ANSWER `{ acceptedAnswers, typoTolerance }`,
  /// SLIDER `{ slider: { min, max, step, correct, margin, unit? } }`, ORDER `{ items }` (right
  /// order), PIN `{ zone: { x, y, radius } }`, WHO_OF_US `{ majorityBonus }`; null otherwise.
  config           Json?
  /// Sound clip played on the host screen (`audio` in @lbq/shared): file URL, excerpt start
  /// (seconds) and length (5–30 s); all null without a sound.
  audioUrl         String?
  audioStartSec    Float?
  audioDurationSec Int?
  /// Play the clip at REVEAL instead of during ANSWERING; null = false.
  audioOnReveal    Boolean?
  /// Picture reveal effect (only with `imageUrl`); null = none.
  imageEffect      ImageEffect?
  /// « Buzzer » (T28): phones get a BUZZ button, the host judges the answer said out loud.
  buzzer           Boolean      @default(false)
  /// « 💡 Le saviez-vous ? » (T37): shown from the reveal on; null = none.
  explanation      String?

  @@unique([quizId, order])
}

enum ImageEffect {
  none
  blur
  zoom
  pixelate
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int // 0–3, maps to the shape/color (see SHAPES in @lbq/shared)
  text       String
  isCorrect  Boolean

  @@unique([questionId, order])
}

model GameSession {
  id        String           @id @default(cuid())
  /// Null once the quiz is deleted; history is kept thanks to `quizTitle`.
  quizId    String?
  quiz      Quiz?            @relation(fields: [quizId], references: [id], onDelete: SetNull)
  quizTitle String
  hostId    String
  host      User             @relation(fields: [hostId], references: [id], onDelete: Cascade)
  pin       String
  mode      GameMode         @default(solo)
  /// Played with jokers (T25).
  jokers    Boolean          @default(false)
  /// « Survie » (T31): hearts each player started with; null for the other modes.
  hearts    Int?
  startedAt DateTime         @default(now())
  endedAt   DateTime?
  results   PlayerResult[]
  questions QuestionResult[]
  teams     TeamResult[]

  @@index([hostId, startedAt])
}

model PlayerResult {
  id            String      @id @default(cuid())
  gameSessionId String
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  nickname      String
  /// Avatar id (AVATARS in @lbq/shared); null for games saved before avatars.
  avatar        String?
  score         Int
  correctCount  Int
  rank          Int
  /// Team mode: team id (0–3 = shape index, see TEAM_NAMES in @lbq/shared); null in solo games.
  teamId        Int?
  /// Jokers played during the game (JokerType ids, in order); empty without jokers.
  jokersUsed    String[]    @default([])
  /// « Survie » (T31): hearts left at the end (0 = ghost); null for the other modes.
  hearts        Int?
  /// « Survie »: question index where the player lost their last heart (null: survivor).
  eliminatedAt  Int?

  @@index([gameSessionId, rank])
}

enum GameMode {
  solo
  teams
  survival
}

/// Team mode: final standing of one team (score = sum of per-question averages, PLAN.md §3).
model TeamResult {
  id            String      @id @default(cuid())
  gameSessionId String
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  teamId        Int
  name          String
  score         Int
  /// Players in the team at the end of the game.
  playerCount   Int
  rank          Int

  @@unique([gameSessionId, teamId])
}

/// Snapshot of one played question (text/choices as they were) and how players answered it.
model QuestionResult {
  id             String       @id @default(cuid())
  gameSessionId  String
  gameSession    GameSession  @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  /// Position in the quiz (0-based).
  index          Int
  type           QuestionType @default(MCQ)
  text           String
  choices        String[]
  correctIndexes Int[]
  /// Number of players per choice (same order as `choices`).
  distribution   Int[]
  /// Players in the game when the question was revealed (answered or not).
  playerCount    Int
  correctCount   Int
  /// Players who answered; null for games saved before question types (= sum of distribution).
  answerCount    Int?
  /// Type-specific reveal details (`RevealDetails` in @lbq/shared: typed answers, slider
  /// guesses, order, pins, votes, words); null otherwise.
  details        Json?
  /// The question's explanation when it was played (T37); null = none / older games.
  explanation    String?

  @@unique([gameSessionId, index])
}

/// Uploaded pictures and sounds (served at `/uploads/<name>`), stored in the database so the
/// server keeps no files of its own. `name` = content hash (or random id) + extension.
model Media {
  name        String   @id
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
}
