// Data model — see docs/PLAN.md §5. Connection URL lives in prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  passwordHash        String
  createdAt           DateTime             @default(now())
  quizzes             Quiz[]
  sessions            Session[]
  gameSessions        GameSession[]
  passwordResetTokens PasswordResetToken[]
}

/// Host login session. `id` is the SHA-256 of the opaque token given to the client.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// "Mot de passe oublié" link. `id` is the SHA-256 of the token sent by e-mail; valid 1 hour,
/// single use (`usedAt`). A new request deletes the user's previous unused tokens.
model PasswordResetToken {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Quiz {
  id            String         @id @default(cuid())
  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  coverImageUrl String?
  /// PUBLIC quizzes are listed in the library and can be launched / copied by any host.
  visibility    QuizVisibility @default(PRIVATE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  questions     Question[]
  gameSessions  GameSession[]

  @@index([ownerId])
  @@index([visibility, createdAt])
}

enum QuizVisibility {
  PRIVATE
  PUBLIC
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  TYPE_ANSWER
  POLL
  SLIDER
}

model Question {
  id               String       @id @default(cuid())
  quizId           String
  quiz             Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order            Int
  text             String
  imageUrl         String?
  type             QuestionType @default(MCQ)
  timeLimitSec     Int          @default(20)
  basePoints       Int          @default(1000)
  /// MCQ / TRUE_FALSE / POLL (poll choices are all `isCorrect: false`); empty for the others.
  choices          Choice[]
  /// Type-specific settings: TYPE_ANSWER `{ acceptedAnswers, typoTolerance }`,
  /// SLIDER `{ slider: { min, max, step, correct, margin, unit? } }`; null otherwise.
  config           Json?
  /// Sound clip played on the host screen (`audio` in @lbq/shared): file URL, excerpt start
  /// (seconds) and length (5–30 s); all null without a sound.
  audioUrl         String?
  audioStartSec    Float?
  audioDurationSec Int?
  /// Play the clip at REVEAL instead of during ANSWERING; null = false.
  audioOnReveal    Boolean?
  /// Picture reveal effect (only with `imageUrl`); null = none.
  imageEffect      ImageEffect?

  @@unique([quizId, order])
}

enum ImageEffect {
  none
  blur
  zoom
  pixelate
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int // 0–3, maps to the shape/color (see SHAPES in @lbq/shared)
  text       String
  isCorrect  Boolean

  @@unique([questionId, order])
}

model GameSession {
  id        String           @id @default(cuid())
  /// Null once the quiz is deleted; history is kept thanks to `quizTitle`.
  quizId    String?
  quiz      Quiz?            @relation(fields: [quizId], references: [id], onDelete: SetNull)
  quizTitle String
  hostId    String
  host      User             @relation(fields: [hostId], references: [id], onDelete: Cascade)
  pin       String
  mode      GameMode         @default(solo)
  /// Played with jokers (T25).
  jokers    Boolean          @default(false)
  startedAt DateTime         @default(now())
  endedAt   DateTime?
  results   PlayerResult[]
  questions QuestionResult[]
  teams     TeamResult[]

  @@index([hostId, startedAt])
}

model PlayerResult {
  id            String      @id @default(cuid())
  gameSessionId String
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  nickname      String
  /// Avatar id (AVATARS in @lbq/shared); null for games saved before avatars.
  avatar        String?
  score         Int
  correctCount  Int
  rank          Int
  /// Team mode: team id (0–3 = shape index, see TEAM_NAMES in @lbq/shared); null in solo games.
  teamId        Int?
  /// Jokers played during the game (JokerType ids, in order); empty without jokers.
  jokersUsed    String[]    @default([])

  @@index([gameSessionId, rank])
}

enum GameMode {
  solo
  teams
}

/// Team mode: final standing of one team (score = sum of per-question averages, PLAN.md §3).
model TeamResult {
  id            String      @id @default(cuid())
  gameSessionId String
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  teamId        Int
  name          String
  score         Int
  /// Players in the team at the end of the game.
  playerCount   Int
  rank          Int

  @@unique([gameSessionId, teamId])
}

/// Snapshot of one played question (text/choices as they were) and how players answered it.
model QuestionResult {
  id             String       @id @default(cuid())
  gameSessionId  String
  gameSession    GameSession  @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  /// Position in the quiz (0-based).
  index          Int
  type           QuestionType @default(MCQ)
  text           String
  choices        String[]
  correctIndexes Int[]
  /// Number of players per choice (same order as `choices`).
  distribution   Int[]
  /// Players in the game when the question was revealed (answered or not).
  playerCount    Int
  correctCount   Int
  /// Players who answered; null for games saved before question types (= sum of distribution).
  answerCount    Int?
  /// TYPE_ANSWER / SLIDER reveal details (`RevealDetails` in @lbq/shared); null otherwise.
  details        Json?

  @@unique([gameSessionId, index])
}
