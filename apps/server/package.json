{
  "name": "@lbq/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/index.ts",
    "build": "prisma generate && node build.mjs",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env --import ./dist/instrument.js dist/index.js",
    "postinstall": "prisma generate",
    "typecheck": "prisma generate && tsc -p .",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "quiz:import": "node --env-file-if-exists=../../.env --import tsx scripts/import-quiz.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "@lbq/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "^11.8.0",
    "fastify": "^5.12.7",
    "nodemailer": "^8.0.11",
    "prisma": "7.10.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  }
}
