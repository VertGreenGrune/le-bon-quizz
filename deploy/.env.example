# Copy to deploy/.env (never committed) and fill in. See SELF-HOSTING.md.

# The address of the site, without https://. Your own domain (its DNS A record pointing to the
# server), or a free one built from the server's IP: 152-67-10-20.sslip.io for 152.67.10.20.
DOMAIN=152-67-10-20.sslip.io

# Database password: any long random string, e.g. the output of `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me

# Optional: e-mails for « Mot de passe oublié » (without them, the reset link is in the app logs).
# SMTP_URL=smtps://user:password@smtp-relay.brevo.com:465
# MAIL_FROM=Le Bon Quizz <noreply@your-domain.fr>
