{
  "name": "le-bon-quizz",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @lbq/server --filter @lbq/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p e2e",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@lbq/shared": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
