# Copy to .env (gitignored). Everything is optional in dev.

# Server
PORT=3001
# Allowed web origin. Leave unset in dev so phones on the LAN can connect.
# CORS_ORIGIN=https://lebonquizz.example

# Web (Vite): URL of the game server.
# Leave unset in dev: defaults to http://<same host as the page>:3001 (works for LAN phones).
# VITE_SERVER_URL=https://api.lebonquizz.example
