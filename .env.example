# Copy to .env (gitignored). Everything is optional in dev.

# Server
PORT=3001
# Allowed web origin. Leave unset in dev so phones on the LAN can connect.
# CORS_ORIGIN=https://lebonquizz.example

# Database (docker compose up -d). Default below matches docker-compose.yml.
# DATABASE_URL=postgresql://lbq:lbq@localhost:5432/lbq
# Enables the API integration tests (database is wiped by the tests!)
# TEST_DATABASE_URL=postgresql://lbq:lbq@localhost:5432/lbq_test
# Password of the seeded demo host (demo@lebonquizz.local)
# SEED_DEMO_PASSWORD=demo1234

# Uploaded images (local disk, served at /uploads/). Relative to apps/server.
# UPLOAD_DIR=uploads
# Public base URL used in upload URLs (default: the request's host)
# PUBLIC_URL=https://api.lebonquizz.example

# E-mails (password reset). Unset in dev: sent to Mailpit (docker compose up -d mailpit,
# inbox at http://localhost:8025). Unset in production: links are written to the server log.
# SMTP_URL=smtps://<login>:<smtp key>@smtp-relay.brevo.com:465
# MAIL_FROM="Le Bon Quizz <noreply@lebonquizz.example>"
# Web app origin used in the e-mailed links (default: CORS_ORIGIN, else the request's origin)
# PUBLIC_WEB_URL=https://lebonquizz.example

# Production (set by the Dockerfile / fly.toml, see DEPLOY.md)
# NODE_ENV=production                # also makes the session cookie Secure
# WEB_DIST_DIR=../web/dist           # serve the built web app from the server (same origin)
# TRUST_PROXY=true                   # behind a TLS-terminating proxy (Fly.io)

# Sentry (error monitoring) — off when unset
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0        # 0..1, performance tracing

# Web (Vite, baked in at build time): URL of the game server.
# Leave unset: dev defaults to http://<same host as the page>:3001 (works for LAN phones),
# a production build defaults to the page's own origin.
# VITE_SERVER_URL=https://api.lebonquizz.example
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
